# Copy this file to deploy.env and edit at least MODEL_HOST_PATH.

BASE_IMAGE=quay.io/ascend/sglang:v0.5.16-cann9.0.0-a3
RUNTIME_IMAGE=sglang-ascend-mooncake:v0.5.16-cann9.0.0-a3-mc0.3.11.post1
MOONCAKE_VERSION=0.3.11.post1

# Optional APT mirrors used only while building the derived Ubuntu image.
# x86_64 archive example: https://mirrors.ustc.edu.cn/ubuntu
# aarch64 ports example:  https://mirrors.ustc.edu.cn/ubuntu-ports
# Keep APT_SECURITY_MIRROR empty to continue using Ubuntu's official security
# source. For Ubuntu Ports, security suites share the ports mirror URL.
APT_MIRROR=
APT_SECURITY_MIRROR=
APT_PORTS_MIRROR=https://mirrors.ustc.edu.cn/ubuntu-ports

# The host path is mounted read-only at MODEL_CONTAINER_PATH.
MODEL_HOST_PATH=/data/models/Qwen3-32B
MODEL_CONTAINER_PATH=/models/model
TOKENIZER_HOST_PATH=
TOKENIZER_CONTAINER_PATH=/models/tokenizer
HF_CACHE_HOST_PATH=/data/hf-cache

# Required read-write home directories mounted into Prefill/Decode workers.
# Comma-separated; each directory is mounted to the same path in the container.
REQUIRED_HOME_MOUNTS=/home/tcj,/home/caofei,/home/cryang_wx1511021

# single: prefill uses NPU 0-15 and decode uses NPU 16-31; requires 32 NPUs.
# split: prefill and decode run on separate A3 servers; both use local NPU 0-15.
DEPLOY_MODE=single
NPU_COUNT_PER_ROLE=16
TP_SIZE=16

# Routable service IPs. In single mode, 127.0.0.1 is sufficient.
# In split mode set each value to that server's service-plane IP.
PREFILL_IP=127.0.0.1
DECODE_IP=127.0.0.1
ROUTER_IP=0.0.0.0

PREFILL_HTTP_PORT=30000
DECODE_HTTP_PORT=30001
PREFILL_BOOTSTRAP_PORT=8998
ROUTER_PORT=8000

# Ascend Direct dynamically chooses one port per physical NPU from
# [ASCEND_BASE_PORT + phy_id*100, ASCEND_BASE_PORT + (phy_id+1)*100].
PREFILL_ASCEND_BASE_PORT=20000
DECODE_ASCEND_BASE_PORT=24000

# SGLang/Mooncake uses a dynamically allocated TCP RPC port as well.
# Keep host networking enabled and allow the host ephemeral TCP port range
# between P and D nodes when DEPLOY_MODE=split.

MEM_FRACTION_STATIC=0.80
CONTEXT_LENGTH=32768
MAX_RUNNING_REQUESTS=64
CHUNKED_PREFILL_SIZE=8192
DTYPE=bfloat16
TRUST_REMOTE_CODE=1

# HCCL/Gloo service-plane NIC. Leave empty to let the runtime choose.
HCCL_SOCKET_IFNAME=
GLOO_SOCKET_IFNAME=

# Mooncake Ascend Direct / ADXL network controls.
# CANN 9.0 supports auto-connect and Mooncake recommends enabling it.
ASCEND_AUTO_CONNECT=1

# Leave empty to use the default HCCS path inside an A3 supernode. Set to 1
# when the validated deployment topology must use the NPU RoCE/RDMA path.
HCCL_INTRA_ROCE_ENABLE=

# Optional RoCE and connection tuning. Keep empty until the baseline passes.
ASCEND_RDMA_TC=
ASCEND_RDMA_SL=
HCCL_RDMA_TIMEOUT=
HCCL_RDMA_RETRY_CNT=
ASCEND_CONNECT_TIMEOUT=
ASCEND_TRANSFER_TIMEOUT=

# Optional additional launch_server arguments, for example:
# EXTRA_PREFILL_ARGS="--quantization modelslim --disable-cuda-graph"
# EXTRA_DECODE_ARGS="--quantization modelslim --cuda-graph-bs 1 2 4 8 16"
EXTRA_PREFILL_ARGS=
EXTRA_DECODE_ARGS=

# Operational settings.
SHM_SIZE=64g
LOG_DIR=/var/log/sglang-mooncake
CONTAINER_PREFIX=sglang-mc
SGLANG_LOG_LEVEL=info
SGLANG_DISAGGREGATION_BOOTSTRAP_TIMEOUT=600
SGLANG_DISAGGREGATION_WAITING_TIMEOUT=600

# Set to 1 only if the host requires the broader privileged mode.
USE_PRIVILEGED=0

# Optional host NPU slog/profiling/dump mounts. Enable only while diagnosing or
# profiling, because these expose writable host log directories to workers.
ENABLE_NPU_DIAGNOSTIC_MOUNTS=0
